{
  "manifest_version": 3,
  "name": "ReviewLens Scraper Test",
  "version": "0.1.6",
  "description": "Internal-only build for testing ReviewLens review extraction on public Shopify product pages.",
  "action": {
    "default_title": "ReviewLens Scraper Test",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
